# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# OpenAI API key (required for Step 9 — LLM concept extraction)
# Without this, Step 9 runs regex-only extraction (no LLM)
OPENAI_API_KEY=

# SMTP config path (optional — only needed for email alerts)
# Copy smtp_config.json.example to smtp_config.json and fill in your credentials
